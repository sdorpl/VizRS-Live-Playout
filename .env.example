# Skopiuj do .env i ustaw własne wartości (min. 16 znaków: litery, cyfry, -._~).
# Wygeneruj np.: head -c 24 /dev/urandom | base64 | tr -d '/+='
VIZRS_BRIDGE_TOKEN=
VIZRS_LIVE_TOKEN=

# Wersja ErsatzTV legacy (przypnij konkretną po teście mostu, np. ghcr.io/ersatztv/legacy:v26.11.6)
LEGACY_IMAGE=ghcr.io/ersatztv/legacy:latest

# Odnośniki w panelu (opcjonalnie)
VIZRS_LIVE_STREAM_URL=http://localhost:8409
VIZRS_LIVE_VIZRS_URL=

# Katalogi
ETV_CONFIG=./etv-config
MEDIA_DIR=./media
TZ=Europe/Warsaw
