# Skopiuj do .env i ustaw własne wartości (min. 16 znaków: litery, cyfry, -._~).
# Wygeneruj np.: head -c 24 /dev/urandom | base64 | tr -d '/+='
VIZRS_BRIDGE_TOKEN=
VIZRS_LIVE_TOKEN=

# Wersje przypięte (wydanie 1.1.0). Zmiana wersji legacy: docs/RUNBOOK.md „Aktualizacja legacy”.
# Obrazy VizRS Live (ghcr.io/sdorpl): panel i legacy z mostem (tag = wersja panelu + wersja legacy).
LIVE_IMAGE=ghcr.io/sdorpl/vizrs-live:1.1.0
LIVE_LEGACY_IMAGE=ghcr.io/sdorpl/vizrs-live-legacy:1.1.0-legacy26.12.0
# Obraz bazowy legacy – używany tylko przy budowie na miejscu (docker compose up -d --build);
# po zmianie ustaw też własną nazwę LIVE_LEGACY_IMAGE, np. vizrs-live-legacy:local-26.13.0
LEGACY_IMAGE=ghcr.io/ersatztv/legacy:v26.12.0

# Odwrotne proxy przed legacy (R10): na zewnątrz tylko strumienie, M3U/XMLTV, HDHomeRun
PROXY_IMAGE=caddy:2.10.2-alpine

# Odnośniki w panelu (opcjonalnie)
VIZRS_LIVE_STREAM_URL=http://localhost:8409
VIZRS_LIVE_VIZRS_URL=

# VizRS CG Playout (grafika kanału, sloty na żywo; R9). Token = panel_token / VIZRS_PANEL_TOKEN w CG Playout.
VIZRS_LIVE_CG_URL=
VIZRS_LIVE_CG_TOKEN=

# Katalogi
ETV_CONFIG=./etv-config
MEDIA_DIR=./media
TZ=Europe/Warsaw
