# Skopiuj do .env i ustaw własne wartości (min. 16 znaków: litery, cyfry, -._~).
# Wygeneruj np.: head -c 24 /dev/urandom | base64 | tr -d '/+='
VIZRS_BRIDGE_TOKEN=
VIZRS_LIVE_TOKEN=

# Panel (ghcr.io/sdorpl): zawsze najnowsze wydanie; konkretna wersja = :<wersja>. Aktualizacja: docs/RUNBOOK.md §4.
LIVE_IMAGE=ghcr.io/sdorpl/vizrs-live:latest
# Legacy: zawsze najnowsze oficjalne ghcr.io/ersatztv/legacy; obraz z mostem budowany na miejscu
# przy każdym docker compose up (sprawdza nowsze legacy). Lokalna nazwa obrazu z mostem:
LIVE_LEGACY_IMAGE=vizrs-live-legacy:local
LEGACY_IMAGE=ghcr.io/ersatztv/legacy:latest

# Odwrotne proxy przed legacy (R10): na zewnątrz tylko strumienie, M3U/XMLTV, HDHomeRun
PROXY_IMAGE=caddy:alpine

# Odnośniki w panelu (opcjonalnie)
VIZRS_LIVE_STREAM_URL=http://localhost:8409
# VizRS CG System (podgląd /output, odnośnik do Trio) – adres widziany z przeglądarki operatora;
# sam port (:8788) = ten sam host co panel. VizRS z tokenem: token wyjścia (VIZRS_OUTPUT_TOKEN, tylko odczyt).
# Anteny kanałów (channel_buses / VIZRS_CHANNEL_BUSES=1 w CG Playout): VIZRS_LIVE_VIZRS_CHANNELS=1.
VIZRS_LIVE_VIZRS_URL=
VIZRS_LIVE_VIZRS_OUTPUT_TOKEN=
VIZRS_LIVE_VIZRS_CHANNELS=0

# VizRS CG Playout (grafika kanału, sloty na żywo; R9). Token = panel_token / VIZRS_PANEL_TOKEN w CG Playout.
VIZRS_LIVE_CG_URL=
VIZRS_LIVE_CG_TOKEN=

# Katalogi
ETV_CONFIG=./etv-config
MEDIA_DIR=./media
TZ=Europe/Warsaw
