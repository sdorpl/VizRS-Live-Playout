{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VizRS Live",
  "mainBinaryName": "vizrs-live-desktop",
  "version": "26.11.3",
  "identifier": "pl.vizrs.Live",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "VizRS Live – panel kanału",
    "longDescription": "Panel kanału VizRS Live nad ErsatzTV legacy: panel lokalny (vizrs-live dołączony do paczki) albo klient panelu zdalnego z tokenem trzymanym w programie.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "copyright": "VizRS",
    "publisher": "VizRS",
    "homepage": "https://github.com/sdorpl/VizRS-Live"
  }
}
